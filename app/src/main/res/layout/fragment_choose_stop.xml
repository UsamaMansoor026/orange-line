<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ic_bottom_sheet_bg"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.95" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/search"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:fontFamily="@font/bold"
        app:layout_constraintTop_toTopOf="parent"
        android:paddingTop="20dp"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        android:id="@+id/title"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/routeHeaderMain"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintTop_toBottomOf="@id/title">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/routeHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/ic_edit_text_bg"
            android:padding="16dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- TO -->
            <EditText
                android:id="@+id/toText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:drawablePadding="10dp"
                android:fontFamily="@font/medium"
                android:gravity="center_vertical"
                android:text="Khatam-E-Nabuwat"
                android:maxLines="1"
                android:textColor="@color/end_color"
                android:textSize="16sp"
                android:hint="@string/where_to"
                android:textColorHint="@color/dark_gray"
                android:background="@android:color/transparent"
                android:inputType="textPersonName"
                android:digits="abcdefghijklmnopqrstuvwxyz"
                app:drawableStartCompat="@drawable/ic_from"
                app:layout_constraintEnd_toStartOf="@id/btnSwap"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:background="@color/light_gray"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnSwap"
                app:layout_constraintTop_toBottomOf="@id/toText"
                app:layout_constraintBottom_toTopOf="@id/fromText"
                android:layout_marginEnd="16dp"/>
            <!-- FROM -->
            <EditText
                android:id="@+id/fromText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:drawablePadding="10dp"
                android:fontFamily="@font/medium"
                android:gravity="center_vertical"
                android:text="Canal View"
                android:hint="@string/where_from"
                android:inputType="textPersonName"
                android:digits="abcdefghijklmnopqrstuvwxyz"
                android:textColor="@color/start_color"
                android:textSize="16sp"
                android:textColorHint="@color/dark_gray"
                android:maxLines="1"
                android:layout_marginTop="16dp"
                android:background="@android:color/transparent"
                app:drawableStartCompat="@drawable/ic_to"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnSwap"
                app:layout_constraintTop_toBottomOf="@id/toText"/>
            <!-- SWAP -->
            <ImageView
                android:id="@+id/btnSwap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:src="@drawable/ic_switch_location"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <EditText
            android:id="@+id/stopName"
            android:layout_width="0dp"
            android:background="@drawable/ic_edit_text_bg"
            android:drawableStart="@drawable/ic_to"
            android:padding="10dp"
            android:hint="@string/where_to"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:visibility="visible"
            android:drawablePadding="10dp"
            android:fontFamily="@font/medium"
            android:drawableEnd="@drawable/ic_current_location"
            android:layout_height="48dp"
            android:textColorHint="@color/dark_gray"
            android:maxLines="1"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:focusable="true"
            android:layout_marginTop="20dp"
            android:focusableInTouchMode="true"
            android:cursorVisible="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintTop_toBottomOf="@id/routeHeaderMain"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:paddingBottom="10dp"
        android:clipToPadding="false"
        android:visibility="gone"
        android:overScrollMode="always"
        android:nestedScrollingEnabled="true"
        tools:listitem="@layout/layout_stop_item"
        android:id="@+id/recyclerView"/>

</androidx.constraintlayout.widget.ConstraintLayout>