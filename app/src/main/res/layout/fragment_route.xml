<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.route.RouteFragment">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.05" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/centerGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.3" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/bottomGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.95" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.95" />

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:src="@drawable/ic_map_bg"
        android:scaleType="centerCrop"/>

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/centerGuide"
        android:src="@drawable/ic_gradient_bg"
        android:scaleType="centerCrop"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/route"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:fontFamily="@font/bold"
        app:layout_constraintTop_toBottomOf="@id/topGuide"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        android:id="@+id/title"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/routeDetailsHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/endGuide"
        app:layout_constraintTop_toBottomOf="@id/title"
        android:background="@drawable/ic_button_bg"
        android:backgroundTint="@color/white"
        android:translationZ="10dp"
        android:layout_marginTop="10dp"
        android:padding="10dp">

        <TextView
            android:id="@+id/stationsIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/stations"
            android:textSize="10sp"
            android:fontFamily="@font/medium"
            android:textColor="@color/dark_gray"
            app:drawableStartCompat="@drawable/ic_stations"
            android:drawablePadding="5dp"
            app:layout_constraintEnd_toStartOf="@id/stations"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/stations"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_26"
            android:textSize="12sp"
            android:fontFamily="@font/bold"
            android:textColor="@color/app_color"
            app:layout_constraintStart_toEndOf="@id/stationsIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/distanceIcon"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/distanceIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/distance"
            android:textSize="10sp"
            android:fontFamily="@font/medium"
            android:textColor="@color/dark_gray"
            android:layout_marginStart="5dp"
            app:drawableStartCompat="@drawable/ic_route_distance"
            android:drawablePadding="5dp"
            app:layout_constraintEnd_toStartOf="@id/distance"
            app:layout_constraintStart_toEndOf="@id/stations"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_27_1_km"
            android:textSize="12sp"
            android:fontFamily="@font/bold"
            android:textColor="@color/app_color"
            app:layout_constraintStart_toEndOf="@id/distanceIcon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/routeTimeIcon"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/routeTimeIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/route_time"
            android:textSize="10sp"
            android:fontFamily="@font/medium"
            android:textColor="@color/dark_gray"
            android:layout_marginStart="5dp"
            app:drawableStartCompat="@drawable/ic_route_time"
            android:drawablePadding="5dp"
            app:layout_constraintStart_toEndOf="@id/distance"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/routeTime"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/routeTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/_58_mins"
            android:textSize="12sp"
            android:fontFamily="@font/bold"
            android:textColor="@color/app_color"
            app:layout_constraintStart_toEndOf="@id/routeTimeIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ROUTE STOPS CONTAINER -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/routeDetailsHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/startGuide"
        app:layout_constraintEnd_toStartOf="@id/endGuide">

        <LinearLayout
            android:id="@+id/routeStopsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="15dp"
            android:clipToPadding="false">

            <!-- START STATION -->
            <TextView
                android:id="@+id/startStation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ali Town"
                android:textSize="18sp"
                android:fontFamily="@font/bold"
                android:textColor="@color/black"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- TIMELINE AREA -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/timelineContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/startStation"
                app:layout_constraintBottom_toTopOf="@id/endStation">

                <!-- ORANGE LINE -->
                <View
                    android:id="@+id/routeLine"
                    android:layout_width="16dp"
                    android:layout_height="0dp"
                    android:layout_marginVertical="16dp"
                    android:background="@drawable/ic_button_bg"
                    android:backgroundTint="@color/app_color"
                    app:layout_constraintTop_toTopOf="@id/stopsRecycler"
                    app:layout_constraintBottom_toBottomOf="@id/stopsRecycler"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <!-- MIDDLE STOPS -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/stopsRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingVertical="16dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:itemCount="10"
                    tools:listitem="@layout/item_route_stop_name" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- END STATION -->
            <TextView
                android:id="@+id/endStation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dera Gujran"
                android:textSize="18sp"
                android:fontFamily="@font/semi_bold"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>